{
  "name": "zamanadil",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server.js",
    "build": "npm run build -w zamanadil-client && node scripts/client-stamp.mjs",
    "audit": "npm audit",
    "verify": "node scripts/verify-production.mjs"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "esbuild": "$esbuild",
    "follow-redirects": "1.16.2",
    "qs": "6.16.1"
  },
  "devDependencies": {
    "pdfkit": "^0.20.2"
  }
}
