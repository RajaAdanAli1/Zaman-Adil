# Copy to server/.env. Do not commit the filled-in file.
# Production must set MONGO_URI and a unique JWT_SECRET of at least 32 characters.
# Production will not start an in-memory database, and it will not seed the built-in development password.

NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 only behind one trusted reverse proxy. Leave empty when the app is reached directly.
TRUST_PROXY=
# Optional. A random salt is generated at startup when this is empty.
IP_HASH_SALT=
# Used only when creating the first admin account. Required in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional. Contact mail is delivered over the web. Defaults to the site owner when empty.
MAIL_TO=
