# Copy to server/.env for local development. Do not commit the filled-in file.
# Do not import this file on Hostinger. Use hostinger.env.example there.
# Production does not read server/.env. A missing MONGO_URI or JWT_SECRET stops startup.
# Production will not start an in-memory database, and it will not accept the built-in development password.

NODE_ENV=development
PORT=5000
# Optional local bind address. Production defaults to 0.0.0.0 when HOST is unset.
HOST=
# Persistent MongoDB connection string. Required in production.
# MONGODB_URI is accepted when MONGO_URI is empty.
MONGO_URI=
JWT_SECRET=
# Optional. Leave empty for the single-origin site. Comma-separated origins only; * is ignored.
CLIENT_ORIGIN=http://localhost:5173
# Production trusts one reverse-proxy hop (Hostinger). Set 0 to disable, or 2 if a second trusted hop is required.
TRUST_PROXY=
# Optional. A random salt is generated at startup when this is empty. Set a stable value so rate-limit keys survive restarts.
IP_HASH_SALT=
# Used only when creating the first admin account. ADMIN_PASSWORD is required in production and must be at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Public site origin used as the contact-mail referrer. Defaults to https://zamanadil.com.
SITE_URL=
# Optional inbox for contact mail. Defaults to the site owner when empty.
MAIL_TO=
